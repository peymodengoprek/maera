              "steps": {
                "type": "array",
                "description": "Daftar langkah; langkah dengan `at` terbesar yang cocok dipakai. Satu langkah tanpa `at` menjadi cadangan.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "anyOf": [
                    {
                      "required": [
                        "text"
                      ]

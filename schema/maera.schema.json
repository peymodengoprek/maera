                  "equal": {
                    "description": "Teks saja atau objek { text, status }.",
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "anyOf": [
                          {
                            "required": [
                              "text"
                            ]
                          },
                          {
                            "required": [
                              "status"
                            ]
                          }
                        ],
                        "properties": {
                          "text": {
                            "type": "string",

                    }
                  ],
                  "properties": {
                    "at": {
                      "type": "number",
                      "description": "Ambang inklusif (value >= at). Kosongkan untuk cadangan."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Teks hasil."
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "info",
                        "warning",
                        "danger"
                      ],
                      "description": "Warna status: ok, info, warning, danger."
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "state",
                    "steps"
                  ]
                }
              }

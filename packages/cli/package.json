{
  "name": "@maera-js/cli",
  "version": "0.5.1",
  "description": "CLI maera: dev server, builder HTML mandiri, dan generator JSON Schema untuk *.maera.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "maera": "./dist/bin.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/cli.test.ts test/pages.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@maera-js/core": "^0.5.1",
    "@maera-js/ui": "^0.5.1",
    "esbuild": "^0.25.0"
  }
}


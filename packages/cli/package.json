{
  "name": "@maera/cli",
  "version": "0.1.0",
  "description": "CLI maera: dev server, builder HTML mandiri, dan generator JSON Schema untuk *.maera.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "maera": "./dist/bin.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@maera/core": "^0.1.0",
    "@maera/ui": "^0.1.0",
    "esbuild": "^0.25.0"
  }
}

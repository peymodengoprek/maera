{
  "name": "@maera/ui",
  "version": "0.3.0",
  "description": "Renderer DOM/SVG untuk dashboard maera.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/format.test.ts test/renderer.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@maera/core": "^0.3.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}

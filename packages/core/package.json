{
  "name": "@maera-js/core",
  "version": "0.4.0",
  "description": "Compiler, reactive store, dan data sources untuk maera — tanpa dependensi DOM.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/compiler.test.ts test/conditions.test.ts test/store.test.ts test/sources.test.ts test/schema.test.ts test/formatter.test.ts",
    "check:example": "tsx test/check-example.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ws": "^8.23.0"
  }
}
